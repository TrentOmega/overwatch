# Optional: select the AI CLI used for research + synthesis
# OVERWATCH_AI_PROVIDER=claude

# Optional: override the selected provider's model
# OVERWATCH_AI_MODEL=claude-opus-4-6

# Backward-compatible alias for model override
# OVERWATCH_MODEL=claude-opus-4-6

# Optional: override the active provider command entirely.
# The command must accept the prompt on stdin.
# OVERWATCH_AI_COMMAND='codex --search exec --skip-git-repo-check --sandbox read-only --color never -'

# Optional: timeout for the AI subprocess
# OVERWATCH_AI_TIMEOUT=600

# Optional: YouTube cookies file for bypassing IP blocks
# Export from browser: yt-dlp --cookies-from-browser chrome --cookies cookies.txt --skip-download "https://youtube.com"
# Or use a browser extension like "Get cookies.txt LOCALLY"
# YOUTUBE_COOKIES_FILE=./cookies.txt

# Optional: web search backend (pick one)
# SEARXNG_URL=http://localhost:8080
# BRAVE_SEARCH_API_KEY=your-key
# SERPER_API_KEY=your-key
